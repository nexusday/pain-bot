# Copia este archivo a .env y ajusta los valores.
# .env NO se sube al repositorio (ya está en .gitignore).
#
# En Pterodactyl no necesitas .env: define estas mismas variables en
# Startup -> Environment. Las variables reales del proceso tienen prioridad
# sobre este archivo.

# Panel web
PAIN_WEB_ENABLED=1
PAIN_WEB_HOST=0.0.0.0
PAIN_WEB_PORT=10022
PAIN_WEB_SUBDOMAIN=pain
PAIN_WEB_DOMAIN=nexcodea.com

# Déjalo vacío para usar https://<subdominio>.<dominio>.
# Para probar en local sin proxy: http://localhost:10022
PAIN_WEB_PUBLIC_URL=

# Cuenta administradora inicial.
# Si PAIN_WEB_ADMIN_PASS queda vacío, se genera una contraseña aleatoria y se
# guarda en storage/webpanel-admin.txt. Define una clave larga y única aquí.
PAIN_WEB_ADMIN_USER=admin
PAIN_WEB_ADMIN_PASS=admin
# Correo del administrador principal (recuperación de contraseña y avisos).
PAIN_WEB_ADMIN_EMAIL=
# Usa 1 solo para recuperar el acceso. Quítalo después de restablecerla.
PAIN_WEB_ADMIN_RESET=0

# Registro e invitaciones
PAIN_WEB_ALLOW_REGISTER=1
PAIN_WEB_REQUIRE_INVITE=0
PAIN_WEB_INVITE=

# Proxy / HTTPS
PAIN_WEB_TRUST_PROXY=1

# Modo unico (recomendado): un solo proceso para principal + sub-bots.
# Los plugins se cargan una vez y no hay locks de handshake entre procesos.
# PAIN_SINGLE_PROCESS=0 vuelve al supervisor clasico de 5 grupos.
PAIN_SINGLE_PROCESS=1
PAIN_SINGLE_HEAP_MB=2048
PAIN_START_CONCURRENCY=6
PAIN_SOCKET_HANDSHAKE_CONCURRENCY=6
PAIN_RECONNECT_CONCURRENCY=4

# Límites anti-abuso (opcionales)
# PAIN_WEB_SESSION_TTL=604800000
# PAIN_WEB_PAIR_TTL=180000
# PAIN_WEB_CODE_TTL=90000
# PAIN_WEB_MAX_LINKS_HOUR=8
# PAIN_WEB_MAX_LINKS_DAY=30
# PAIN_WEB_MAX_LINKS_IP_HOUR=20
